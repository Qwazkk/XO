<Window x:Class="XO.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игра" Height="800" Width="1100" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock x:Name="GameStatus" Text="Игра началась!" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="Вернуться в меню" Click="OnLeaveGame" Padding="10,5" Background="DarkRed" Foreground="White"/>
            </StackPanel>

            <TextBlock x:Name="StatusMessage" Grid.Row="1" Text="" FontSize="24" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10"/>

            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E0E0E0">
                <UniformGrid x:Name="BoardGrid" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Column="1" Margin="10">
            <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10" Background="White">
                <StackPanel>
                    <TextBlock x:Name="YourNameText" Text="Вы:" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="YourStatsText" Text="Побед: 0 | Поражений: 0" Margin="0,0,0,10"/>

                    <Separator Margin="0,0,0,10"/>

                    <TextBlock x:Name="OpponentNameText" Text="Противник: Ожидание..." FontWeight="Bold" FontSize="16" Foreground="DarkRed"/>
                    <TextBlock x:Name="OpponentStatsText" Text="Побед: 0 | Поражений: 0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Чат:" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,5"/>
            <DockPanel DockPanel.Dock="Bottom">
                <Button DockPanel.Dock="Right" Content="Отправить" Click="OnSendChat" Width="80" Margin="5,0,0,0"/>
                <TextBox x:Name="ChatBox" KeyDown="OnChatKey" Padding="2"/>
            </DockPanel>
            <ListBox x:Name="ChatList" Background="#FAFAFA"/>
        </DockPanel>
    </Grid>
</Window>