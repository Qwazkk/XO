<Window x:Class="XO.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход" Height="250" Width="300" WindowStartupLocation="CenterScreen">
    <StackPanel VerticalAlignment="Center" Margin="20">
        <TextBlock Text="Введите никнейм" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtNickname" Padding="5" Margin="0,0,0,15"/>
        <Button Content="Войти" Click="OnLoginClick" Padding="10" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
    </StackPanel>
</Window>